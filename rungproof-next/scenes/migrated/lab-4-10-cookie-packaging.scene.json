  "training": {
    "hints": [
      "Open programs/examples/cookie-packaging-reference.rpproj.json through File -> Open Ladder Agent Project. Default ladder remains an exercise.",
      "Run arms scans; a fresh Start / resume is required to move. Stop holds every tray and the sealer head; Run alone cannot restart motion.",
      "Observe six distinct beam crossings and six sealing cycles. Reset reloads six unwrapped trays and both counts return to zero."
    ],
    "solution": {
      "summary": "Editable offline reference for six-cookie indexing and sealing. PLC owns commands; PC position/crossing feedback owns counts.",
      "steps": [
        "Authorize a cycle on a fresh Start edge with no plant fault or completed batch.",
        "Feed only while the sealer is ready, the station is empty and the batch is incomplete.",
        "Seal only a tray at the station, retaining the command while the head is busy.",
        "Stop clears the authorization; fresh Start resumes a held cycle. Reset clears the batch."
      ],
      "acceptance": "Exactly six optical crossings and six sealed trays; all remain supported and visible after completion."
    },
    "assetRequirements": [
      "food product load",
      "indexing conveyor",
      "packaging machine",
      "product counter"
    ],
    "machineGuide": {
      "purpose": "Six supported cookie trays are optically counted, indexed and sealed; completed packages remain on the outfeed.",
      "startConditions": [
        "Open the editable reference or author equivalent ladder.",
        "Run starts offline scans. Fresh Start authorizes motion."
      ],
      "normalSequence": [
        "Feed the next tray into the stationary sealing position.",
        "Stop feed, lower the ring jaws, hold, and raise them.",
        "Advance the sealed tray and index the next.",
        "After six seals, advance 150 mm and retain all packages on the belt."
      ],
      "stopBehavior": [
        "Stop removes PLC commands and holds head/tray position.",
        "Run alone holds; fresh Start resumes.",
        "Reset restores six unwrapped trays, head home, counts zero and stopped playback."
      ],
      "faultBehavior": [
        "Conflicting feed/seal commands latch packaging_fault and hold the plant until Reset."
      ],
      "expectedObservations": [
        "COOKIES increments on actual leading-edge photoeye crossings; SEALED increments only after a complete head cycle.",
        "There is no automatic replenishment, deletion, recycling, film mechanics or heat-process simulation."
      ]
    },
    "sequenceNumber": 37,
