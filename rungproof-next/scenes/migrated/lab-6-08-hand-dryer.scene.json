  "training": {
    "hints": [
      "Insert hands using the operator input; hands_present is derived from the illustrated sensor zone.",
      "PLC logic owns the timer, blower_run, heater_enable and remaining_seconds.",
      "Use a nonretentive timer; withdrawing hands cancels the interval. A completed interval must wait for withdrawal before restarting."
    ],
    "solution": {
      "summary": "This is an original functional reference for the control concept, not a copy of the photographed solution.",
      "steps": [
        "Start one timed interval when hands enter.",
        "Stop both commands on withdrawal or timer completion.",
        "Calculate remaining_seconds from timer elapsed milliseconds.",
        "Require withdrawal before another cycle."
      ],
      "acceptance": "The blower and heater run only during a valid hand-drying interval."
    },
    "assetRequirements": [
      "hand-presence sensor",
      "air outlet",
      "heating element",
      "progress display"
    ],
    "machineGuide": {
      "purpose": "Hand presence starts a PLC-timed drying interval with blower, heater and live remaining seconds. Illustrated commands are not measured airflow or temperature.",
      "startConditions": [
        "The common PLC/watchdog foundation is healthy.",
        "All required simulator inputs are at their documented initial state."
      ],
      "normalSequence": [
        "Insert hands; a user-authored PLC program starts its timer and outputs.",
        "The PLC calculates remaining seconds; completion removes outputs.",
        "Withdraw and reinsert to rearm."
      ],
      "stopBehavior": [
        "Removing the permissive removes PLC-owned commands.",
        "Reset returns the module to its initial state."
      ],
      "faultBehavior": [
        "A missing or stale input must fail safe and remain diagnosable."
      ],
      "expectedObservations": [
        "The mounted fan and heater project eligible commands.",
        "The readout displays PLC-owned remaining_seconds; the scene does not manufacture a timer result."
      ]
    },
    "sequenceNumber": 51,
