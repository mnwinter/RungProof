  "training": {
    "hints": [
      "Open the editable cable-cut reference, Run scans, then press Start. Run alone leaves the prethreaded cable at zero measured length.",
      "PC owns actual length, stock and knife feedback. PLC owns feed, cutter and cycle authorization.",
      "Stop holds feed and blade pose; Run needs a fresh Start. Completion retains one 3 m piece until Reset."
    ],
    "solution": {
      "summary": "Finite offline feed and cut reference with measured feedback.",
      "steps": [
        "Feed only with cutter home until 3 m is measured.",
        "Stop feed before lowering the cutter.",
        "Observe cut_done, release cutter_fire, return home and retain completion."
      ],
      "acceptance": "One measured 3 m piece stays supported with cutter home and outputs off."
    },
    "assetRequirements": [
      "payoff reel",
      "passive cable guide rolls",
      "length encoder",
      "cable cutter",
      "cut-length display"
    ],
    "machineGuide": {
      "purpose": "One prethreaded cable feeds a measured 3 m length onto a receiving surface, cuts it and returns the blade home. The cut piece remains supported until Reset.",
      "startConditions": [
        "One cable is prethreaded at the cutting plane; available stock is 10 m, excluding the already threaded route.",
        "Load the editable offline reference; no physical PLC is connected."
      ],
      "normalSequence": [
        "Press Run, then Start.",
        "Encoder/reel rotations follow actual feed length at prescribed constant radii.",
        "At 3 m, feed stops; knife travels down then returns home. A 60 mm separation reveals the cut."
      ],
      "stopBehavior": [
        "Stop preserves cable and blade pose; Run alone holds until fresh Start.",
        "Reset restores zero measured length, 10 m available stock, home knife and stopped scans."
      ],
      "faultBehavior": [
        "Simultaneous feed/cut, feed with knife away from home, or cut before target latches a diagnostic fault. Reset is required."
      ],
      "expectedObservations": [
        "LENGTH m finishes at 3.00. stock_remaining_m finishes at 7.0.",
        "The piece stays supported on the receiver. No automatic recycling occurs.",
        "Prescribed no-slip feed and constant-radius reel/rollers; no tension, layering, cutting force, elasticity or collision solver."
      ]
    },
    "sequenceNumber": 39,
