{
  "version": 1,
  "machineGuide": {
    "purpose": "A top-mounted radar transmitter reports level, distance, signal, and echo health from one liquid surface.",
    "startConditions": [
      "Common PLC/watchdog foundation is healthy.",
      "Both pump and drain commands are FALSE; initial level is 35%."
    ],
    "normalSequence": [
      "Operator enables the cycle request; PLC owns inlet_pump_run and drain_valve_open.",
      "Explicit offline review reference fills to an illustrative 80% REAL radar level, drains to 20%, then repeats. Manual drain request excludes filling.",
      "The liquid surface moves; radar distance, engineering level and idealized current share that surface."
    ],
    "stopBehavior": [
      "Removing both commands stops level movement while feedback holds the measured state."
    ],
    "faultBehavior": [
      "No echo-loss or signal-noise process is modeled; radar_echo_ok is idealized true.",
      "External PLC transport remains separate from this symbolic model."
    ],
    "expectedObservations": [
      "The transmitter electronics sit above the roof, away from the manway.",
      "The internal beam ends at the simulated liquid surface; the opaque shell/roof hide it in normal views.",
      "Distance uses the antenna lens datum; echo health remains an idealized true feedback, without an echo-loss model.",
      "Inlet route joins the pump discharge to the tank nozzle; outlet flange joins the tank to a supported drain valve and labeled drain boundary. These are illustrative routes, not hydraulic ratings.",
      "Use the explicit inspection view to ghost the shell/roof and inspect the internal beam and liquid surface; toggle again to restore opaque materials. This view does not simulate a physical opening.",
      "Generate the review reference explicitly with --audit-radar-layout and open .tools/plant-review-radar.rpproj.json through File. Default exercise stays blank; thresholds are illustrative, not hardware limits."
    ]
  },
