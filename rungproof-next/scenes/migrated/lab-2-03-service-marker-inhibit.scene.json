      "type": "switch",
      "label": "Marker inhibit button",
      "position": [
        -1.6,
        0,
        0
      ],
      "config": {
        "style": "pushbutton",
        "action": "toggle-marker-inhibit",
        "faceLabel": "INHIBIT",
        "color": 14695473
      }
    },
    {
      "id": "service_marker_lamp",
      "type": "indicator",
