  "training": {
    "hints": [
      "This exercise opens with an empty ladder project. Run alone does not implement arithmetic.",
      "Click the A NEXT and B NEXT readouts, or use their sidebar actions, to cycle each DINT operand through 0, 1, 2, 5, 10.",
      "Use ADD for the sum, a rising call-complete edge qualified by inputs_valid and calculate_request for each counter event, and MOV the counter ACC to event_count after its update.",
      "The call_complete input is manually supplied PC feedback; the scene does not execute a machine call to generate it."
    ],
    "solution": {
      "summary": "An opt-in editable offline reference is provided in programs/examples/09-sum-counter-reference.rpproj.json. It is not automatically loaded into this exercise.",
      "steps": [
        "Open that project from the Ladder workspace, then Verify + Load and Run.",
        "The always-scanned FC computes the valid sum and completion event. The global counter retains state; this is not an instance-local FC counter.",
        "Enable inputs_valid and calculate_request, choose operands, then toggle call_complete off/on for each completion.",
        "A held completion does not recount, and enabling a permissive after an invalid held completion does not manufacture an event."
      ],
      "acceptance": "For A=2 and B=5, a valid completion publishes SUM=7 and increments COUNT once; held completion does not recount. Stop zeroes PLC output images, Run republishes retained count, Reset clears inputs and memory."
    },
    "assetRequirements": [
      "three labeled operator stations",
      "two output lamps",
      "four live numeric readouts"
    ],
    "machineGuide": {
      "purpose": "Numeric sum and event-count exercise: manual operands and call-complete input; PLC-authored logic owns the result and count.",
      "startConditions": [
        "Built-in virtual controller selected; no physical PLC is required.",
        "Author or explicitly load the reference ladder, then Verify + Load and Run."
      ],
      "normalSequence": [
        "Choose A and B with the A NEXT and B NEXT readouts or sidebar actions.",
        "Enable INPUTS VALID and CALCULATE; toggle manual CALL COMPLETE off/on for each new completion.",
        "With the reference, SUM shows the qualified arithmetic result and COUNT advances once per valid completion edge."
      ],
      "stopBehavior": [
        "Stop clears the PLC output image and both output readouts show zero; internal counter memory is retained.",
        "Run republishes retained count. Reset clears operand values, manual inputs, outputs and counter memory."
      ],
      "faultBehavior": [
        "A completion while a permissive is false is not counted. Restoring that permissive while completion remains held must not count it."
      ],
      "expectedObservations": [
        "A NEXT and B NEXT immediately show their PC input values.",
        "SUM and COUNT stay zero with the empty exercise program.",
        "With the opt-in reference: A=2, B=5 and one valid completion yield SUM=7, COUNT=1; event_counted is a one-scan pulse, result_valid follows the three Boolean inputs."
      ]
    },
    "sequenceNumber": 54,
