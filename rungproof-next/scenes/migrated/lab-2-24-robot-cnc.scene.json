  "training": {
    "hints": [
      "Define the required result before writing logic: The CNC runs only while the robot is stopped; the part exits after machining complete.",
      "Treat blank_at_pickup, cnc_ready, machining_complete as simulator-to-PLC inputs. The PLC should command only infeed_run, outfeed_run, robot_run, cnc_run.",
      "Use a step/state approach and prove the transition order: infeed blank \u2192 pickup \u2192 machining \u2192 machine complete \u2192 unload \u2192 outfeed \u2192 ready."
    ],
    "solution": {
      "summary": "This is one valid functional reference. The same behavior may be implemented in LAD, FBD, or SCL; the rung layout is not prescribed.",
      "steps": [
        "infeed blank: infeed_run = true.",
        "pickup: infeed_run = false, robot_run = true.",
        "machining: robot_run = false, cnc_run = true.",
        "machine complete: cnc_run = false.",
        "unload: robot_run = true.",
        "outfeed: robot_run = false, outfeed_run = true.",
        "ready: outfeed_run = false."
      ],
      "acceptance": "The CNC runs only while the robot is stopped; the part exits after machining complete."
    },
    "machineGuide": {
      "purpose": "Offline reference: a joint-driven robot carries one blank through open CNC access, seats it on a supported vise, waits for a machining timer and delivers it to outfeed. Feedback-driven door/clamp interlocks and normal controller operation remain unverified.",
      "startConditions": [
        "The common PLC/watchdog foundation is healthy.",
        "All required simulator inputs are at their documented initial state.",
        "The PLC is ready to command infeed_run, outfeed_run, robot_run, cnc_run."
      ],
      "normalSequence": [
        "infeed blank",
        "pickup",
        "machining",
        "machine complete",
        "unload",
        "outfeed",
        "ready"
      ],
      "stopBehavior": [
        "A normal stop removes PLC-owned commands and leaves the equipment in a safe state.",
        "Reset returns the scene to its documented initial condition."
      ],
      "faultBehavior": [
        "A missing, stale, or incorrectly typed input must not be replaced by simulator logic.",
        "A missing PLC command leaves the affected equipment stopped and the test diagnosable."
      ],
      "expectedObservations": [
        "Preview action opens access and retracts the tool before the gripped stock crosses the opening.",
        "Released stock remains on the vise support; the robot parks and access closes before the machining timer.",
        "The same stock is regripped and delivered to outfeed. Reset is required after completion or interruption.",
        "Timed reference states do not prove sensed completion, clamp feedback or PLC interlock operation."
      ]
    },
