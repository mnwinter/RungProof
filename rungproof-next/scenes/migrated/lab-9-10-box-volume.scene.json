  "training": {
    "hints": [
      "L/W/H mm NEXT cycle manual DINT dimensions: 0,250,500,720,850,1000 mm. These inputs do not resize the static carton or come from the illustrated sensor heads.",
      "The three buttons toggle manual dimension-valid flags. The reference also requires each numeric value to be 1..1000 mm before multiplying.",
      "The PLC-authored program owns volume_mm3 and volume_result_valid. An old displayed value is invalid while its lamp is off."
    ],
    "solution": {
      "summary": "Original offline reference: Main always calls FB_Volume; two qualified MUL networks calculate length times width times height through global base_area_mm2 memory. This does not model FB parameter transfer, instance-local storage or sensor acquisition.",
      "steps": [
        "Open programs/examples/09-box-volume-reference.rpproj.json with Project > Open, verify and load offline, then Run.",
        "Set length=850, width=720, height=720 mm and enable all three validity flags. VOLUME mm3 displays 440640000 and its lamp turns green.",
        "Zero, negative, above 1000 mm or a missing validity flag clears result-valid and retains the last result. Stop zeroes outputs; Reset clears all values and inputs."
      ],
      "acceptance": "All dimensions must be positive and at most 1000 mm. Qualified volume is length*width*height in mm3; 1000*1000*1000=1000000000 fits DINT."
    },
    "assetRequirements": [
      "Static three-head dimension fixture and supported carton",
      "Three manual dimension-valid pushbuttons",
      "Three clickable live DINT millimetre input readouts",
      "Live PLC-owned DINT cubic-millimetre volume and validity lamp"
    ],
    "machineGuide": {
      "purpose": "Set manual length, width and height in mm, then confirm each validity flag. Your loaded ladder program calculates volume in mm3. The fixture is static.",
      "startConditions": [
        "Local offline runtime selected; load the reference or author a program."
      ],
      "normalSequence": [
        "Open programs/examples/09-box-volume-reference.rpproj.json with Project > Open, verify and load offline, then Run.",
        "Set length=850, width=720, height=720 mm and enable all three validity flags. VOLUME mm3 displays 440640000 and its lamp turns green."
      ],
      "stopBehavior": [
        "Zero, negative, above 1000 mm or a missing validity flag clears result-valid and retains the last result. Stop zeroes outputs; Reset clears all values and inputs."
      ],
      "faultBehavior": [
        "Do not treat a retained volume as valid when the validity lamp is off.",
        "The 1000 mm reference limit keeps the three-factor product within DINT range."
      ],
      "expectedObservations": [
        "All dimensions must be positive and at most 1000 mm. Qualified volume is length*width*height in mm3; 1000*1000*1000=1000000000 fits DINT.",
        "The carton remains supported on the bench; its three heads are static mounting illustrations, not simulated measuring sensors.",
        "An empty exercise does not calculate until a program is loaded."
      ]
    },
    "sequenceNumber": 56,
