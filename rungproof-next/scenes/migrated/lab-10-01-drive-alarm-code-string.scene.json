  "training": {
    "hints": [
      "Verify + Load the supplied editable STRING ladder before Run; received messages are offline fixtures, not fieldbus reception.",
      "CODEMATCH compares whole alphanumeric tokens in drive_alarm_text against selected_alarm_code, initially F003; F0030, prefixes, suffixes and lowercase do not match.",
      "PC supplies drive_alarm_text, drive_alarm_string_valid and alarm_reset; PLC computes alarm_code_found, alarm_match_valid and drive_alarm_active.",
      "Edit selected_alarm_code from F003 to F030, Apply and Verify + Load; observe reversed F003/F030 results, then Undo and Verify + Load to restore."
    ],
    "solution": {
      "summary": "Supplied editable offline STRING ladder performs whole-code matching; validity and Reset gate all match and alarm commands.",
      "steps": [
        "Verify + Load, Run, enable MESSAGE VALID and cycle received message fixtures.",
        "Match the selected complete code token only; Reset or invalid-message status removes all match/alarm outputs.",
        "Edit selected_alarm_code, Apply and Verify + Load to change matching; restore the original project and test Stop/Reset."
      ],
      "acceptance": "The actual received text is displayed; valid F003 matches the default code, F030 and lookalikes do not, and an authored code edit changes results after Verify + Load."
    },
    "assetRequirements": [
      "VFD diagnostic panel",
      "fieldbus alarm-string display",
      "drive status indicator"
    ],
    "machineGuide": {
      "purpose": "Editable loaded STRING ladder matches complete drive alarm codes in received text; validity and Reset gate the alarm outputs. Offline symbolic message fixtures.",
      "startConditions": [
        "Verify + Load the supplied editable STRING ladder.",
        "Run, enable MESSAGE VALID, then cycle received messages."
      ],
      "normalSequence": [
        "F003 matches the default selected_alarm_code; F030, F0030, prefixes, lowercase and empty messages do not.",
        "Edit selected_alarm_code in the tag table, Apply then Verify + Load to select a different code."
      ],
      "stopBehavior": [
        "Stop removes BOOL commands and freezes equipment. Reset restores empty received text and the declared selected code."
      ],
      "faultBehavior": [
        "A missing or stale input must fail safe and remain diagnosable."
      ],
      "expectedObservations": [
        "The live display shows received STRING text; alarm_code_found and both alarm lamps are derived by the loaded program."
      ]
    },
    "sequenceNumber": 59,
