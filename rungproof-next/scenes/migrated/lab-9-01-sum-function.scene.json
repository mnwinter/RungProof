  "training": {
    "hints": [
      "Cycle A NEXT and B NEXT through 0, 1, 2, 5, 10. These are manual PC-owned DINT inputs.",
      "Require operand_a_valid, operand_b_valid and calculate_request before ADD writes sum_result.",
      "Always scan the calculation block so sum_result_valid clears on permissive loss."
    ],
    "solution": {
      "summary": "Original offline reference using global symbolic tags; FB interfaces and instance-local storage are not modeled.",
      "steps": [
        "Open programs/examples/09-sum-function-reference.rpproj.json in Project > Open, verify and load offline, then Run.",
        "Set A=2 and B=5, then enable both valid inputs and CALCULATE. Expect SUM 7.",
        "A lost permissive clears validity while the result retains its last value. Stop clears the output image; Reset clears all manual inputs and values."
      ],
      "acceptance": "A=2 and B=5 produce SUM 7 only with all three permissives; sum_result_valid clears when any permissive is lost."
    },
    "assetRequirements": [
      "Three labeled manual validity/request pushbuttons",
      "Two clickable, live DINT input readouts",
      "Live PLC-owned SUM DINT result readout and validity indicator"
    ],
    "machineGuide": {
      "purpose": "Offline sum calculation exercise with two manually selected DINT values and a live SUM result. Validity requires both manual input-valid flags and CALCULATE. Open programs/examples/09-sum-function-reference.rpproj.json to run the supplied reference.",
      "startConditions": [
        "Local offline runtime selected; a reference or student program must be loaded."
      ],
      "normalSequence": [
        "Open programs/examples/09-sum-function-reference.rpproj.json in Project > Open, verify and load offline, then Run.",
        "Set A=2 and B=5, then enable both valid inputs and CALCULATE. Expect SUM 7."
      ],
      "stopBehavior": [
        "A lost permissive clears validity while the result retains its last value. Stop clears the output image; Reset clears all manual inputs and values."
      ],
      "faultBehavior": [
        "Do not treat a retained result as valid after permissive loss."
      ],
      "expectedObservations": [
        "A=2 and B=5 produce SUM 7 only with all three permissives; sum_result_valid clears when any permissive is lost.",
        "An empty exercise has no calculation controller until a program is loaded."
      ]
    },
