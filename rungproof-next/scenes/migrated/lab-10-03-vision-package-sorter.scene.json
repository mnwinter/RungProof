  "training": {
    "hints": [
      "Translate the lesson into explicit state and permissive logic: Sorting is enabled only for a present package with a valid vision result and clear destination.",
      "Inputs are simulator feedback (package_present, vision_result_valid, destination_clear, vision_class); PLC logic owns sort_conveyor_run, diverter_enable.",
      "Select simulated vision_class 1-4; the class display is hidden until vision_result_valid. This is a fixture, not camera image recognition.",
      "Travel latches the class until Reset. Conveyor moves infeed/discharge; diverter indexes the table. Keep package, result and destination permissives true. Completion retains the carton on its receiving lane.",
      "Test the initial state, the valid condition, and at least one missing permissive."
    ],
    "solution": {
      "summary": "This is an original functional reference for the control concept, not a copy of the photographed solution.",
      "steps": [
        "Require the documented inputs: package_present, vision_result_valid, destination_clear.",
        "Command the documented outputs: sort_conveyor_run, diverter_enable.",
        "Remove PLC commands when the permissive is lost."
      ],
      "acceptance": "Sorting is enabled only for a present package with a valid vision result and clear destination."
    },
    "assetRequirements": [
      "industrial vision camera",
      "package-class result display",
      "four-lane diverter",
      "destination conveyor bank"
    ],
    "machineGuide": {
      "purpose": "A vision result routes packages to one of four destination lanes using a conveyor and actuator handshake.",
      "startConditions": [
        "The common PLC/watchdog foundation is healthy.",
        "All required simulator inputs are at their documented initial state."
      ],
      "normalSequence": [
        "Apply the requested input condition.",
        "Verify only the documented PLC outputs respond."
      ],
      "stopBehavior": [
        "Removing the permissive removes PLC-owned commands.",
        "Reset returns the module to its initial state."
      ],
      "faultBehavior": [
        "A missing or stale input must fail safe and remain diagnosable."
      ],
      "expectedObservations": [
        "Sorting is enabled only for a present package with a valid vision result and clear destination."
      ]
    },
