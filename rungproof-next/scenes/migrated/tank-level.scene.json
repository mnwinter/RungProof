  "verification": {
    "cases": [
      {
        "name": "inlet pump raises level and transmitter together",
        "actions": [
          "run-simulation",
          "toggle-pump"
        ],
        "phases": [
          {
            "runForS": 1.0
          }
        ],
        "expect": {
          "inlet_pump_run": true,
          "tank_level": 49.05833333333316,
          "level_transmitter": 11.849333333333306
        }
      },
      {
        "name": "stopped process holds its level and clears commands",
        "actions": [
          "run-simulation",
          "toggle-pump"
        ],
        "phases": [
          {
            "runForS": 1.0
          },
          {
            "action": "stop-simulation",
            "runForS": 1.0
          }
        ],
        "expect": {
          "inlet_pump_run": false,
          "drain_valve_open": false,
          "tank_level": 49.05833333333316,
          "level_transmitter": 11.849333333333306
        }
      }
    ]
