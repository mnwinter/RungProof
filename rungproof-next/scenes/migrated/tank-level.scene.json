      "Common PLC/watchdog foundation is healthy.",
      "Both pump and drain commands are FALSE; initial level is 42%."
    ],
    "normalSequence": [
      "PLC commands inlet_pump_run or drain_valve_open.",
      "The liquid surface moves.",
      "Switches and level_transmitter follow the same surface."
    ],
    "stopBehavior": [
      "Removing both commands holds the process and returns actual rates to zero."
    ],
    "faultBehavior": [
      "A missing command does not start equipment.",
      "Stale feedback remains stale and is not replaced by the simulator."
    ],
    "expectedObservations": [
      "The idealized transmitter follows 4 + 16 x level_fraction mA."
    ]
  },
