  "training": {
    "hints": [
      "Verify + Load the supplied editable label ladder before Run, then Load product: tray travel takes 0.3 s and measured weight settles after 0.5 s.",
      "FORMAT_TEXT formats actual weight_kg using editable label_template; stable weight, valid data, printer readiness and nonempty text permit printing.",
      "Printing captures exact PLC label_text and takes 0.6 s; actual print_complete permits a separate 0.5 s application; held requests do not duplicate jobs.",
      "Edit label_template from CHICKEN {0:F3} kg to CHICKEN {0:F2} kg, Apply and Verify + Load; measured 1.237 kg prints 1.24 kg, then restore with Undo and Verify + Load."
    ],
    "solution": {
      "summary": "Supplied editable ladder formats measured product weight and sequences printer/application commands; the plant supplies measurement and actual completion feedback.",
      "steps": [
        "Verify + Load and Run; load a product, enable label_data_valid and wait for product_weighed.",
        "Enable printer_ready; FORMAT_TEXT creates nonempty label_text (at most 255 UTF-16 code units), and print_request starts actual paper printing.",
        "Wait for print_complete before apply_request; observe actual application_complete and the retained printed caption.",
        "Edit the format template and Verify + Load to change actual label text; Stop freezes the paper and Reset restores absent product/hidden paper."
      ],
      "acceptance": "Actual measured weight drives editable formatted text, paper printing and separately commanded application; authored F3-to-F2 changes the captured caption after Verify + Load."
    },
    "assetRequirements": [
      "food product load",
      "checkweigher",
      "label printer",
      "formatted label display"
    ],
    "machineGuide": {
      "purpose": "Measured product weighing, PLC-authored label text, timed printing and separately commanded application. No controller is selected automatically.",
      "startConditions": [
        "Load or author an offline controller; unauthored Run does not synthesize PLC commands.",
        "Printer-ready and data-valid fixtures begin false."
      ],
      "normalSequence": [
        "Wait for product_weighed and require printer_ready and label_data_valid.",
        "Supply nonempty label_text (maximum 255 characters), then raise print_request.",
        "Wait for print_complete before raising apply_request; observe application_complete."
      ],
      "stopBehavior": [
        "Stop freezes model and animation; Reset clears job and restores absent off-platform home.",
        "Printer/data permissive loss pauses printing."
      ],
      "faultBehavior": [
        "A missing or stale input must fail safe and remain diagnosable."
      ],
      "expectedObservations": [
        "Measured weight is zero until stable, then default product measures 1.237 kg.",
        "Paper extrudes while printing and travels to tray only on separate application command.",
        "Printed text remains the exact accepted PLC text even if label_text later changes."
      ]
    },
    "sequenceNumber": 60,
