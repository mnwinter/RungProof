  "training": {
    "hints": [
      "Open programs/examples/barrel-fill-reference.rpproj.json through File -> Open Ladder Agent Project. Default empty ladder remains an exercise.",
      "Run starts scans; fresh Start authorizes travel/fill. Stop holds position and volume; Run alone stays held.",
      "Observe 150 L transferred from the 200 L source, then a supported barrel retained on the outfeed. Reset reloads the finite batch."
    ],
    "solution": {
      "summary": "Editable offline one-barrel metered filling sequence. PLC owns commands; PC observes position and conserved liquid volume.",
      "steps": [
        "Authorize on a fresh Start, no fault and no completed barrel.",
        "Index the empty barrel beneath the fixed nozzle before opening the valve.",
        "At 150 L, close fill, latch discharge permission while the downstream zone is clear and move to the retained stop.",
        "Stop clears authorization; fresh Start resumes the same held batch."
      ],
      "acceptance": "150 L in the barrel, 50 L in the source, both commands off and the barrel retained at the outfeed."
    },
    "assetRequirements": [
      "barrel/container load",
      "flow meter",
      "fill nozzle"
    ],
    "machineGuide": {
      "purpose": "One supported barrel indexes under a connected nozzle, receives a measured 150 L batch and remains on the outfeed.",
      "startConditions": [
        "Open the editable reference or author equivalent ladder.",
        "Run starts offline scans; fresh Start authorizes the finite batch."
      ],
      "normalSequence": [
        "Index the supported empty barrel at X=0.",
        "Transfer liquid at prescribed 20 L/s until 150 L is measured.",
        "Close fill, discharge while authorized and retain the barrel at X=3."
      ],
      "stopBehavior": [
        "Stop clears commands and holds barrel position and volume.",
        "Run alone holds; fresh Start resumes.",
        "Reset restores the empty infeed barrel, 200 L source and stopped playback."
      ],
      "faultBehavior": [
        "Fill during feed or without an indexed barrel latches fill_fault until Reset; raw commands remain visible."
      ],
      "expectedObservations": [
        "Litres are conserved; source plus barrel remains 200 L.",
        "No hydraulic head, valve transit, fluid slosh, slip or replenishment is modeled."
      ]
    },
    "sequenceNumber": 38,
