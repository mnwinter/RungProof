  "training": {
    "hints": [
      "Translate the lesson into explicit state and permissive logic: A Ladder CTU counts pulse_received rising edges and turns the lamp on at its preset.",
      "Inputs are simulator feedback (pulse_received); PLC logic owns threshold_lamp.",
      "Wait for pulse_received to return false before pressing again. The starter preset is three; Stop removes the lamp command and Reset clears the counter."
    ],
    "solution": {
      "summary": "This is an original functional reference for the control concept, not a copy of the photographed solution.",
      "steps": [
        "Count rising edges of pulse_received with a CTU. The starter preset is three.",
        "Command threshold_lamp from the counter's done state.",
        "Stop removes the lamp command while retaining the count; Reset clears the count and returns the lamp off."
      ],
      "acceptance": "A Ladder CTU counts pulse_received rising edges and turns the lamp on at its preset."
    },
    "assetRequirements": [],
    "machineGuide": {
      "purpose": "A discrete counter lesson turns a station lamp on after a defined number of operator pulses.",
      "startConditions": [
        "Use the built-in offline controller with the matching Demo 1 logic loaded and no active forces.",
        "Run the app scan, release PULSE, and use machine RESET so COUNT is 0 and the threshold lamp is off."
      ],
      "normalSequence": [
        "Run the authored starter program.",
        "Press PULSE three times, allowing the input to release between presses.",
        "Verify the COUNT display advances 1, 2, 3 while threshold_lamp stays off for the first two pulses and turns on after the third."
      ],
      "stopBehavior": [
        "Stop removes the lamp command without clearing the counter.",
        "Reset clears the counter and returns the input and lamp to false."
      ],
      "faultBehavior": [
        "A held PULSE supplies only one rising edge and must not repeatedly increment the CTU.",
        "If COUNT changes without a fresh edge, inspect pulse_received and press_count in the live trace before continuing."
      ],
      "expectedObservations": [
        "A Ladder CTU counts pulse_received rising edges, publishes its accumulator to the COUNT display, and turns the lamp on at its preset.",
        "Machine Reset returns COUNT to 0 and the threshold lamp to off; a new pulse begins a fresh count at 1."
      ],
      "acceptance": "Three distinct PULSE presses produce COUNT 3 and threshold_lamp ON; RESET returns COUNT 0 and lamp OFF."
    },
    "sequenceNumber": 28,
