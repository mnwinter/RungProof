  "training": {
    "hints": [
      "ENTRY and EXIT come from finite optical segments intersecting the delivered bag body; they are not manual inputs.",
      "conveyor_run is the run enable. conveyor_reverse selects reverse while run is enabled; both true means valid reverse, not conflicting direction coils.",
      "PAUSE CLEAR is a manual maintained acknowledgement, not an automatic obstruction detector. A new START at EXIT requests the return."
    ],
    "solution": {
      "summary": "Original illustrative four-phase reference: idle, forward, wait for operator, return. Default exercise remains empty.",
      "steps": [
        "START at ENTRY selects forward; actual EXIT feedback stops the run.",
        "Wait at EXIT. Require PAUSE CLEAR and a fresh START to select reverse.",
        "ENTRY stops the return; another fresh START can begin the next outbound pass."
      ],
      "acceptance": "Actual bag remains supported; real sensor transitions govern stops; reverse is held when manual PAUSE CLEAR is absent."
    },
    "assetRequirements": [
      "bag product load",
      "integral conveyor drive",
      "START button and PAUSE CLEAR selector"
    ],
    "machineGuide": {
      "purpose": "Actual bag indexing between ENTRY and EXIT beams. At EXIT the PLC reference pauses; manual PAUSE CLEAR and a fresh START permit the return.",
      "startConditions": [
        "Open or author and verify a ladder controller; the default exercise is blank.",
        "Use --audit-bag-index to generate .tools/plant-review-bag-index.rpproj.json for explicit File Open.",
        "Bag initially blocks ENTRY and both commands are false."
      ],
      "normalSequence": [
        "Run enables accepted 20 ms scans. START moves the bag forward at the original illustrative 0.5 m/s.",
        "EXIT stops the forward command. A START without PAUSE CLEAR has no effect.",
        "Select CLEAR and press START again to return; ENTRY stops the return."
      ],
      "stopBehavior": [
        "Stop clears PLC commands, stops belt animation and retains actual bag position and PLC phase. Run resumes the selected direction if its permissives allow.",
        "Reset restores the preloaded bag at ENTRY, BLOCKED acknowledgement, zero scan and outputs off."
      ],
      "faultBehavior": [
        "Reverse with run enabled and PAUSE CLEAR absent is inhibited and flagged; PLC commands remain visible.",
        "A missed sensor cannot send the bag off its illustrated belt: bounded travel holds at the endpoint and asserts travel_limited; it does not manufacture a stop command or successful sequence."
      ],
      "expectedObservations": [
        "A rounded filled sack replaces the carton and copied pusher.",
        "Both sensor pairs cross the belt at 1.1 m and derive feedback from BAG_BODY triangles.",
        "Prescribed no-slip motion and rendered contact only; no flexible-body physics, actual drive, safety or PLC transport claim."
      ]
    },
    "sequenceNumber": 48,
