  "simulation": {
    "type": "conveyor",
    "points": [
      {
        "name": "conveyor_run",
        "type": "BOOL",
        "owner": "PLC",
        "initial": false,
        "role": "output",
        "purpose": "PLC motor command that runs the inspection conveyor."
      },
      {
        "name": "estop_ok",
        "type": "BOOL",
        "owner": "SIM",
        "initial": true,
        "purpose": "Scene-local E-stop permissive. False after the simulated E-stop is pressed; Reset restores it."
      },
      {
        "name": "photoeye_blocked",
        "type": "BOOL",
        "owner": "PC",
        "initial": false,
        "purpose": "Simulator photoeye feedback that turns TRUE while a carton blocks the inspection sensor."
      },
      {
        "name": "conveyor_speed",
        "type": "REAL",
        "owner": "SIM",
        "initial": 0,
        "unit": "m/s",
        "purpose": "Internal actual conveyor speed."
      },
      {
        "name": "parts_completed",
        "type": "DINT",
        "owner": "SIM",
        "initial": 0,
        "purpose": "Internal count of cartons that have passed through the cell."
      }
    ],
    "actions": [
      {
        "id": "conveyor_run",
        "label": "Start / stop inspection conveyor",
        "type": "toggle",
        "point": "conveyor_run",
        "controllerStartBinding": "operator.start",
        "controllerStopBinding": "operator.stop",
        "requires": {
          "estop_ok": true
        },
        "blockedMessage": "Reset the simulated E-stop before starting the conveyor."
      },
      {
        "id": "conveyor-estop",
        "label": "Emergency stop conveyor",
        "type": "emergencyStop",
        "point": "estop_ok"
      },
      {
        "id": "conveyor-estop-reset",
        "label": "Reset emergency stop",
        "type": "reset",
        "blockedMessage": "The simulated E-stop reset was not accepted."
      }
    ],
    "safeState": {
      "conveyor_run": false
    },
    "pointBindings": [
      {
        "point": "photoeye_blocked",
        "equipmentId": "inspection_photoeye",
        "mode": "photoeye"
      },
      {
        "point": "conveyor_run",
        "equipmentId": "main_conveyor",
        "mode": "running"
      },
      {
        "point": "estop_ok",
        "equipmentId": "main_conveyor",
        "mode": "estopPermissive"
      }
    ],
    "conveyorId": "main_conveyor",
