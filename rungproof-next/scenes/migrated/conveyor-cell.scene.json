{
  "version": 1,
  "machineGuide": {
    "purpose": "Three cartons circulate through a simulated inspection photoeye on a belt conveyor.",
    "startConditions": [
      "Run enables the built-in offline controller clock.",
      "The simulated emergency stop is reset; a new machine Start is required."
    ],
    "normalSequence": [
      "Machine Start commands conveyor_run TRUE through the offline controller.",
      "A simplified position threshold sets photoeye_blocked; the visible beam follows that point.",
      "At the end, each carton jumps to the upstream position and parts_completed increments. A physical return path is not modeled."
    ],
    "stopBehavior": [
      "conveyor_run FALSE holds carton positions and actual speed returns to zero."
    ],
    "faultBehavior": [
      "The simulated emergency stop stops motion and blocks Run until reset.",
      "No optical sensor fault detection or real PLC watchdog is verified by this scene."
    ],
    "expectedObservations": [
      "Cartons move only when commanded; Stop holds positions and Reset restores the initial layout."
    ]
  },
