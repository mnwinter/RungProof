  "training": {
    "hints": [
      "Start and Step are momentary PC-owned requests. Detect their edges in the PLC program.",
      "PLC logic owns the four tower colors, tower_active status, and sequence_complete status.",
      "Start selects red; four separate Steps select amber, green, blue, then off. Idle scans must not advance.",
      "Reject Step before Start and repeated Start while active. Stop removes commands; a fresh Start begins again at red."
    ],
    "solution": {
      "summary": "This is an original functional reference for the control concept, not a copy of the photographed solution.",
      "steps": [
        "Accept a fresh Start only while inactive and reset the step counter.",
        "Advance one state on each fresh Step while active; decode only one of four color outputs.",
        "After the fourth Step, turn all tower colors off and indicate completion separately.",
        "Stop removes commands; require a fresh Start rather than resuming the previous state."
      ],
      "acceptance": "Red -> amber -> green -> blue -> off; four separate Step presses, exactly one color while active, no idle advance."
    },
    "assetRequirements": [],
    "machineGuide": {
      "purpose": "A four-color tower advances red -> amber -> green -> blue -> off on separate Step requests.",
      "startConditions": [
        "An offline controller program is verified and loaded.",
        "Controller scans are running; the sequence is inactive."
      ],
      "normalSequence": [
        "Accept a fresh Start only while inactive and reset the step counter.",
        "Advance one state on each fresh Step while active; decode only one of four color outputs.",
        "After the fourth Step, turn all tower colors off and indicate completion separately.",
        "Stop removes commands; require a fresh Start rather than resuming the previous state."
      ],
      "stopBehavior": [
        "Stop removes PLC-owned commands.",
        "Run alone does not resume the tower; a fresh Start selects red.",
        "Global Reset clears the counter and returns every point to its initial state."
      ],
      "faultBehavior": [
        "A missing or stale input must fail safe and remain diagnosable."
      ],
      "expectedObservations": [
        "Red -> amber -> green -> blue -> off; four separate Step presses, exactly one color while active, no idle advance."
      ]
    },
    "sequenceNumber": 31,
