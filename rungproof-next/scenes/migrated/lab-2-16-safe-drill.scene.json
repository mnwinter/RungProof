  "training": {
    "hints": [
      "The two hand requests are latched demonstration inputs, checked at Start with workpiece presence and drill_at_top. This scene does not model a safety-rated two-hand or guard interlock.",
      "Define the required result before writing logic: Start is blocked without both requests; a valid cycle drills, retracts, and stops at top.",
      "Treat left_hand_request, right_hand_request, workpiece_present, drill_at_top, drill_at_bottom as simulator-to-PLC inputs. The PLC should command only drill_run.",
      "Use a step/state approach and prove the transition order: spindle start \u2192 drilling \u2192 bottom dwell \u2192 retracting \u2192 cycle complete."
    ],
    "solution": {
      "summary": "This is one valid functional reference. The same behavior may be implemented in LAD, FBD, or SCL; the rung layout is not prescribed.",
      "steps": [
        "spindle start: drill_run = true.",
        "drilling: no PLC command changes.",
        "bottom dwell: no PLC command changes.",
        "retracting: no PLC command changes.",
        "cycle complete: drill_run = false."
      ],
      "acceptance": "Start is blocked without both requests; a valid cycle drills, retracts, and stops at top."
    },
    "machineGuide": {
      "purpose": "A guarded drill cycle requires a present workpiece and both hand-request inputs before the spindle can descend.",
      "startConditions": [
        "The common PLC/watchdog foundation is healthy.",
        "All required simulator inputs are at their documented initial state.",
        "The PLC is ready to command drill_run."
      ],
      "normalSequence": [
        "spindle start",
        "drilling",
        "bottom dwell",
        "retracting",
        "cycle complete"
      ],
      "stopBehavior": [
        "Stop removes the spindle command and holds the current feed position. It does not retract.",
        "After a stopped cycle, Reset restores the simulator's top position before another start."
      ],
      "faultBehavior": [
        "A missing, stale, or incorrectly typed input must not be replaced by simulator logic.",
        "A missing PLC command leaves the affected equipment stopped and the test diagnosable."
      ],
      "expectedObservations": [
        "Start is blocked without both requests; a valid cycle drills, retracts, and stops at top."
      ]
    },
    "sequenceNumber": 16,
