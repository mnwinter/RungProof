  "training": {
    "hints": [
      "Turn INFLOW on to raise the connected bank level. SOURCE HIGH turns on at 65% and stays on until 20%.",
      "The model publishes source_level_percent and source_level_ma; pump and valve commands remain PLC-owned.",
      "Require treatment_ready and outlet_clear. The plant inhibits actual transfer when either downstream permissive is absent, even with a bad PLC command.",
      "Observe simultaneous inflow and transfer, empty/full clamps, overflow, Stop freezing level, and Reset to 35%."
    ],
    "solution": {
      "summary": "This is an original functional reference for the control concept, not a copy of the photographed solution.",
      "steps": [
        "Require the documented inputs: source_level_high, treatment_ready, outlet_clear.",
        "Command the documented outputs: transfer_pump_run, outlet_valve_open.",
        "Remove PLC commands when the permissive is lost."
      ],
      "acceptance": "The pump and outlet valve run only when a source requires service and treatment is ready."
    },
    "assetRequirements": [
      "collection tank bank",
      "level transmitters",
      "pipe manifold",
      "alarm beacon"
    ],
    "machineGuide": {
      "purpose": "Illustrative four-vessel common-header wastewater bank with normalized inflow/transfer, hysteretic source-high feedback and modeled 4-20 mA level. PLC logic owns pump/valve commands; rates are not calibrated hydraulics.",
      "startConditions": [
        "The common PLC/watchdog foundation is healthy.",
        "All required simulator inputs are at their documented initial state."
      ],
      "normalSequence": [
        "Enable inflow and observe normalized bank level and modeled 4-20 mA feedback rise.",
        "With treatment ready and outlet clear, PLC logic commands transfer from high to low threshold.",
        "Disable inflow to drain the bank; inspect hysteretic source-high drop at 20%."
      ],
      "stopBehavior": [
        "Removing the permissive removes PLC-owned commands.",
        "Reset returns the module to its initial state."
      ],
      "faultBehavior": [
        "A missing or stale input must fail safe and remain diagnosable."
      ],
      "expectedObservations": [
        "All four equal-size vessels share the common-header bank level.",
        "Actual transfer depends on pump command, delivered valve opening and both downstream permissives.",
        "A full bank clamps at 100% and reports rejected inflow as overflow; no external receiving tank is modeled."
      ]
    },
    "sequenceNumber": 65,
