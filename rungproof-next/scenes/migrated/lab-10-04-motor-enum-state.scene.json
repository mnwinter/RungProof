  "training": {
    "hints": [
      "Verify + Load the supplied editable ENUM ladder before Run; motor_state retains Stopped, Running or Fault and is displayed in the scene.",
      "PC supplies start_request, stop_request, fault_active and reset_request; motor_running follows motor_state == Running and state_valid checks the declared domain.",
      "Fault dominates Stop and fresh Start; a cleared fault input remains latched until Reset, and held Start cannot restart after Stop or fault Reset.",
      "Edit the Running transition MOV SourceA to Stopped, Apply and Verify + Load: fresh Start remains Stopped with motor_running FALSE; Undo and Verify + Load restores motion."
    ],
    "solution": {
      "summary": "Supplied editable ENUM state machine uses ordered MOV transitions, a fault latch and fresh Start edge; the shaft projects the committed motor command rather than measured motor feedback.",
      "steps": [
        "Verify + Load and Run; a fresh Start edge changes motor_state to Running and commands shaft motion.",
        "Stop request changes state to Stopped; fault changes state to Fault and dominates Reset while fault_active remains TRUE.",
        "Clear the fault input, then Reset the latch; release and reassert Start to run again.",
        "Edit a transition member and Verify + Load to change state and motion; restore with Undo and Verify + Load, then test Stop/Reset."
      ],
      "acceptance": "Named ENUM state controls actual shaft motion; Stop/fault priority, retained fault, fresh-edge restart and authored transition edits behave consistently through Verify + Load and Stop/Reset."
    },
    "assetRequirements": [],
    "machineGuide": {
      "purpose": "Editable loaded ENUM state machine with Stopped, Running and Fault states, Stop/fault priority, latched fault reset and fresh Start requirements.",
      "startConditions": [
        "Verify + Load the supplied editable ENUM ladder.",
        "Release Start, Stop and Fault before Run; Start requires a fresh rising request."
      ],
      "normalSequence": [
        "Start changes motor_state from Stopped to Running; the shaft follows motor_running derived from that named state.",
        "Stop returns Stopped. A fault enters Fault and remains latched after the fault input clears.",
        "Clear the fault input and press FAULT RESET, then release and press Start again."
      ],
      "stopBehavior": [
        "Stop clears motor_running and sets output motor_state to the first declared member Stopped; held Start does not restart.",
        "Reset clears controller memory, named state, fault latch and scene inputs."
      ],
      "faultBehavior": [
        "A missing or stale input must fail safe and remain diagnosable."
      ],
      "expectedObservations": [
        "The live state display and motor_state watch show the actual loaded ENUM value.",
        "Changing the Running transition MOV to Stopped, then Verify + Load, prevents the motor from running on Start."
      ]
    },
