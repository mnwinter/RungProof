  "training": {
    "hints": [
      "Write PLC logic for raw passage events and actual raised feedback. Space availability comes from the two occupied/reserved bays, not a manual ready switch.",
      "Count entry_passed and exit_passed once with separate PLC counters; publish arrivals.ACC minus departures.ACC to occupancy_count.",
      "Open for an arriving vehicle below capacity, or a requested exit. Hold open while passage_occupied. Require driver enable and downstream path clear for vehicle_run.",
      "Entry remains at the stop mark until barrier_raised. Stop freezes the plant; Run resumes. Application Reset empties both training bays and resets PLC memory."
    ],
    "solution": {
      "summary": "Original offline reference; no numeric source capacity, vehicle dimensions or timing were supplied.",
      "steps": [
        "Assume two spaces, 1 m/s vehicle speed and 1 s boom travel through 90 degrees.",
        "Use independent PLC entry/exit CTUs and subtract their accumulators for occupancy_count.",
        "Command barrier_open while enabled and either a clear-path arrival below two, a clear-path requested exit, or actual passage occupation.",
        "Require machine_enabled and exit_clear for vehicle_run. The plant also waits for actual full boom travel before crossing.",
        "Command garage_available while enabled, below two PLC counted vehicles and actual space_available."
      ],
      "acceptance": "Two entries yield two visible parked vehicles and PLC occupancy 2; a third entry is rejected. Each full departure decrements once and remains visible outside until explicit removal or re-entry."
    },
    "assetRequirements": [
      "scene-scoped parking vehicle",
      "scene-scoped hinged barrier",
      "supported parking pad",
      "PLC numeric occupancy display"
    ],
    "machineGuide": {
      "purpose": "Original offline two-bay parking exercise: supported vehicle routes, a hinged barrier, actual passage feedback and a PLC-owned occupancy readout. Capacity and timing are declared training choices.",
      "startConditions": [
        "Open an explicitly authored PLC project; the default exercise editor remains empty.",
        "Run, then set driver enable and downstream path clear."
      ],
      "normalSequence": [
        "Press ENTER to introduce one vehicle; watch approach, full barrier opening, crossing and parking.",
        "Repeat for the second bay; the full garage rejects a third entry.",
        "Press EXIT to reverse one parked vehicle through the raised barrier. REMOVE clears only the fully departed vehicle."
      ],
      "stopBehavior": [
        "Stop holds physical vehicles/boom and scan number, clears PLC output image, and retains counter memory.",
        "Run republishes retained count and resumes the route when enable/path permissives are restored.",
        "Application Reset empties the simulated lot, clears PLC counters and remains stopped."
      ],
      "faultBehavior": [
        "Losing driver enable holds vehicles and boom. Losing path clear holds vehicles; an occupied passage prevents lowering into the vehicle in this offline model.",
        "No real barrier safety function, collision response, vehicle physics or live PLC acceptance is established."
      ],
      "expectedObservations": [
        "No unsupported route, disappearing threshold vehicle or substitute motor-starter/wall models.",
        "PLC readout follows actual accepted arrival/departure edges; parked and fully departed vehicles remain visible.",
        "The capacity, route and timing are original training assumptions, not a manufacturer installation."
      ]
    },
