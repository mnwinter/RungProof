  "training": {
    "hints": [
      "The maintained selector supplies only raw timer_request; PLC owns timing and delayed_lamp.",
      "Demo 2 already contains a two-second TON; the training editor uses that authored document.",
      "There is no manual delay_complete input. Timing uses accepted controller scans, not wall time while stopped."
    ],
    "solution": {
      "summary": "This is an original functional reference for the control concept, not a copy of the photographed solution.",
      "steps": [
        "Select Demo 2, Run, then turn REQUEST ON.",
        "The authored PLC TON keeps the lamp off for 100 accepted 20 ms scans (2 s), then on while REQUEST remains ON.",
        "Turning OFF clears the timer and lamp on the next accepted scan; a new ON needs the full delay."
      ],
      "acceptance": "Two-second TON in existing Demo 2; OFF resets it, Stop resets it, Run with retained ON starts the full delay again."
    },
    "assetRequirements": [],
    "machineGuide": {
      "purpose": "A maintained OFF/ON selector requests the existing authored two-second PLC TON; only PLC timer completion energizes the lamp.",
      "startConditions": [
        "Use the built-in offline controller and the stated authored or explicitly opened reference program.",
        "Initial input false, timer zero and lamp off."
      ],
      "normalSequence": [
        "Select Demo 2, Run, then turn REQUEST ON.",
        "The authored PLC TON advances the ELAPSED MS display to 2000 across 100 accepted 20 ms scans, keeping the lamp off until the preset is reached.",
        "Turning REQUEST OFF clears ELAPSED MS and the lamp on the next accepted scan; a new ON needs the full delay."
      ],
      "stopBehavior": [
        "Stop removes the lamp command and resets the nonretentive TON while retaining selector position.",
        "Run with REQUEST ON starts a fresh full two-second delay; elapsed stopped wall time does not count.",
        "Application Reset returns OFF, zero timer, lamp off and stopped scan zero."
      ],
      "faultBehavior": [
        "A missing or stale input must fail safe and remain diagnosable."
      ],
      "expectedObservations": [
        "ELAPSED MS follows the PLC TON elapsed value from 0 to 2000; the delayed lamp turns on only when the preset is reached.",
        "REQUEST OFF, machine Stop, and machine Reset return elapsed time and lamp output to zero/off; Run with retained ON starts the full delay again."
      ],
      "acceptance": "Maintained REQUEST advances ELAPSED MS to 2000 before delayed_lamp turns ON; REQUEST OFF clears both."
    },
    "sequenceNumber": 40,
