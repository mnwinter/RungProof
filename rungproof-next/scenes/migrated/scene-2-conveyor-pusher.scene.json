  "training": {
    "hints": [
      "Run the built-in controller, turn ENABLE on, clear simulated trip and overload, press machine RESET, then press machine START.",
      "HEIGHT MM shows the measured carton height. The PLC routes values above 600 mm to the side conveyor and values at or below 600 mm to the main conveyor.",
      "DONE advances only after destination feedback completes a carton. Clearing a stop, trip, or overload does not restart motion; issue a fresh machine START."
    ],
    "solution": {
      "summary": "The scanned ladder owns machine state, the 600 mm decision, conveyor/pusher FB calls, interlocks, and recovery; the plant integrates commands and reports feedback.",
      "steps": [
        "Seal machine run from System Enable and Start while Stop, trip, overload, and Reset permit operation.",
        "Compare carton_height_mm with the inclusive 600 mm boundary and retain the divert decision through the transfer.",
        "Command conveyor and pusher FB instances, then use pusher and destination feedback to complete and reset each route."
      ],
      "acceptance": "The fixed 420 mm carton exits the main line, 820 mm exits the side line, and the 600 mm boundary carton exits the main line; DONE reaches three."
    },
    "assetRequirements": [
      "height-measurement portal",
      "main conveyor",
      "side takeaway conveyor",
      "single-solenoid pusher",
      "machine control station",
      "HEIGHT MM and DONE displays"
    ],
    "machineGuide": {
      "purpose": "Three-carton height-sorting lesson with a PLC-owned 600 mm routing decision, conveyor and pusher FBs, measured feedback, interlocks, and repeatable recovery.",
      "startConditions": [
        "Use the built-in offline controller with the matching Demo 3 logic loaded and no active forces.",
        "App scan is running, ENABLE is on, simulated trip and overload are off, and the pusher is retracted.",
        "Press machine RESET, then issue a fresh machine START."
      ],
      "normalSequence": [
        "Follow HEIGHT MM through the fixed 420, 820, and 600 mm carton sequence.",
        "The 420 and 600 mm cartons continue to the main exit; the 820 mm carton is diverted once to the side exit.",
        "DONE advances after each destination feedback and reaches 3 when all boundary cases complete."
      ],
      "stopBehavior": [
        "Machine STOP removes conveyor and pusher commands while preserving a recoverable plant pose.",
        "A simulated trip or overload inhibits motion and fresh restart. Clear the cause, press RESET, then issue a new START.",
        "Application Run alone never asserts the PLC-consumed machine START input."
      ],
      "faultBehavior": [
        "Missing retracted/extended feedback or an occupied route blocks the next unsafe transition and remains visible in the live trace.",
        "The simulated trip is an instructional interlock only; it is not a safety PLC, E-stop circuit, or validated safety function."
      ],
      "expectedObservations": [
        "HEIGHT MM reports 420, 820, then 600 while each carton is measured; DONE reports 1, 2, then 3 after destination completion.",
        "The conveyor-running beacon follows the PLC conveyor command, and the physical pusher follows pusher_extend rather than choosing the route itself.",
        "Machine RESET restores the first carton, DONE 0, HEIGHT MM 0, retracted pusher feedback, and outputs off before a fresh START."
      ],
      "acceptance": "DONE reaches 3 after the 420 mm and 600 mm cartons use the main exit and the 820 mm carton uses the side exit."
    }
  },
