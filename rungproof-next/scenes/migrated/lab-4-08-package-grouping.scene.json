  "training": {
    "hints": [
      "Count actual incoming beam rising edges in PLC logic; no manual group-count-reached input is provided.",
      "Command the conveyor and group-stop release using raw enable/path and actual staged-group feedback.",
      "Three cartons, 0.4 m/s and a one-second stop stroke are original offline training choices."
    ],
    "solution": {
      "summary": "Original offline reference uses a PLC CTU with preset three and a retained release latch; it is not a copy of a photographed or manufacturer solution.",
      "steps": [
        "Enable and clear the downstream path; LOAD stages one actual carton only while feed is idle.",
        "PLC counts actual incoming beam crossings and publishes DINT group_count; completed accumulation feedback permits release.",
        "Hold release while the group crosses; stop movement on lost permissives and retain the group on its powered receiver."
      ],
      "acceptance": "Three actual arrivals form a supported group; its release requires the PLC count, actual staged cartons and downstream clear."
    },
    "assetRequirements": [
      "original aligned powered roller infeed and receiver",
      "original guided group stop",
      "actual entry and receiving beams",
      "PLC-owned numeric group count"
    ],
    "machineGuide": {
      "purpose": "Original offline three-carton grouping exercise: actual optical count feedback, guided accumulation stop and a connected powered receiving surface.",
      "startConditions": [
        "Open an explicitly authored PLC project; the default exercise editor remains empty.",
        "Run, set conveyor enable and downstream clear, then LOAD one carton."
      ],
      "normalSequence": [
        "Wait for the loaded carton to reach its accumulation position before loading another.",
        "Three actual incoming beam edges give PLC count three; actual staged-group feedback permits stop retraction.",
        "Watch all three cartons move onto the connected powered receiver and remain visible."
      ],
      "stopBehavior": [
        "Stop freezes cartons, stop and roller poses while clearing PLC outputs; Run republishes count and resumes retained reference state.",
        "Enable/path loss holds motion; the retained reference release resumes when permissives return.",
        "Application Reset hides all cartons, lowers the stop, clears the PLC count and stays stopped."
      ],
      "faultBehavior": [
        "Incomplete groups cannot physically retract the stop or generate completion.",
        "A fourth load is blocked; Reset starts the next finite three-carton batch."
      ],
      "expectedObservations": [
        "The readout follows PLC CTU count from actual beam feedback, not a PC precomputed ready toggle.",
        "Cartons remain supported on aligned infeed/receiver rollers throughout the transfer.",
        "Prescribed accumulation positions exclude slip, contact forces and collision dynamics; there is no hardware safety or commissioning claim."
      ]
    },
