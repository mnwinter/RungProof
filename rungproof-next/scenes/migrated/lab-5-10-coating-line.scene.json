  "training": {
    "hints": [
      "START is momentary; SPRAY READY and VENT READY are manual maintained permissives, not measured equipment feedback.",
      "STATION and EXIT are calculated from actual workpiece body and finite optical beams. PLC owns index, spray and ventilation commands.",
      "Index to STATION, stop, ventilate while spraying for 2 s, purge for 1 s, discharge to EXIT. These are illustrative reference times."
    ],
    "solution": {
      "summary": "This is an original functional reference for the control concept, not a copy of the photographed solution.",
      "steps": [
        "Require the documented inputs: workpiece_at_station, spray_ready, ventilation_ready.",
        "Command the documented outputs: index_run, spray_enable, vent_run.",
        "Remove PLC commands when the permissive is lost."
      ],
      "acceptance": "Spray is enabled only while the workpiece is positioned and ventilation is ready."
    },
    "assetRequirements": [
      "coating enclosure",
      "spray head",
      "workpiece load",
      "ventilation damper"
    ],
    "machineGuide": {
      "purpose": "A workpiece is indexed into a coating enclosure, sprayed for a timed interval, and discharged after ventilation.",
      "startConditions": [
        "Exercise opens blank; author a PLC program or explicitly open the ignored review reference.",
        "Manual SPRAY READY and VENT READY true, workpiece at its supported home."
      ],
      "normalSequence": [
        "Fresh START indexes to actual STATION.",
        "Reference holds index and runs vent/spray for 2 s.",
        "Spray stops; ventilation continues for a 1 s purge, then index discharges to actual EXIT.",
        "One supported workpiece remains visible; Reset reloads home."
      ],
      "stopBehavior": [
        "Local Stop freezes position/phase and the timer snapshot, and clears output commands. Run resumes the retained phase; the reference nonretentive spray/purge interval starts fresh after cleared commands.",
        "Reset restores raw inputs false, load home and zero scan."
      ],
      "faultBehavior": [
        "Permissive loss inhibits index/spray; reference spray and purge TON timing restarts when eligibility returns.",
        "Malformed simultaneous index/spray inhibits motion and spray, exposes command image and reports diagnostics.",
        "Travel limit holds the supported part without manufacturing a PLC stop or completion."
      ],
      "expectedObservations": [
        "PART stays on the belt, spray is visible only over the actual stationed body with both readiness inputs and vent command.",
        "Fan/damper are symbolic actuator projections; no measured airflow or coating quality is claimed."
      ]
    },
