      "toggle_memory",
      "inspection_light_on"
    ],
    "changedTags": [],
    "previousAcceptance": [
      "lab-2-24-robot-cnc"
    ]
  },
  "verification": {
    "cases": [
      {
        "name": "first-pulse-on",
        "actions": [
          "toggle-inspection-light"
        ],
        "expect": {
          "inspection_light_on": true
        }
      },
      {
        "name": "second-pulse-off",
