  "training": {
    "hints": [
      "PC owns manual request/traffic-stopped feedback and angle-derived bridge/barrier limits; PLC owns all commands.",
      "Require both barriers closed and traffic-stopped feedback before either bridge direction.",
      "Open barriers only after HOME; release green only after barriers reach OPEN. No manual HOME toggle exists."
    ],
    "solution": {
      "summary": "Original explicitly opened offline interlock reference; plant motion durations are illustrative choices.",
      "steps": [
        "Request OPEN closes both road barriers. With raw STOPPED YES and barriers closed, raise to the actual 70-degree limit.",
        "Request CLOSE lowers only with STOPPED YES and barriers closed. Hold red until HOME.",
        "At HOME with CLOSE request, open barriers. Both OPEN limits allow traffic release."
      ],
      "acceptance": "Bridge movement and traffic release are mutually interlocked by actual angle-derived limits."
    },
    "assetRequirements": [
      "drawbridge deck",
      "road barrier",
      "bridge limit switches"
    ],
    "machineGuide": {
      "purpose": "Traffic barriers close before the hinged bridge raises; actual home feedback interlocks barrier opening and traffic release.",
      "startConditions": [
        "Blank exercise: horizontal HOME, both barriers down, PLC commands false and no movement.",
        "Built-in offline controller with user-authored logic or explicitly opened .tools/plant-review-drawbridge.rpproj.json after --audit-drawbridge."
      ],
      "normalSequence": [
        "Run the six-rung reference. CLOSE at HOME opens the barriers, then releases green.",
        "Select OPEN, acknowledge STOPPED YES; barriers close in 2 s, bridge raises in 4 s to 70 degrees.",
        "Select CLOSE: bridge lowers in 4 s to HOME, barriers open in 2 s, then green releases."
      ],
      "stopBehavior": [
        "STOPPED NO removes bridge-direction commands and holds its current angle. Select YES to resume the maintained request.",
        "Application Stop clears outputs and freezes deck/barriers. Run reevaluates retained raw requests and position feedback.",
        "Reset restores horizontal HOME, both gates down, raw manual selectors NO/CLOSE, commands false and stopped scan zero."
      ],
      "faultBehavior": [
        "Conflicting bridge directions inhibit the deck; conflicting gate directions inhibit the barriers. Off-home barrier opening is blocked.",
        "Impossible traffic release asserts motion_inhibited and blocks deck motion. Commanded outputs remain visible for diagnosis; the renderer does not conceal a conflicting red/green PLC image."
      ],
      "expectedObservations": [
        "Bridge deck and limit cam share their actual hinge angle; HOME and RAISED lamps follow limits, not elapsed timers.",
        "The manual traffic-stopped input is an operator simulation acknowledgement; no vehicles, boats or traffic occupancy detector are simulated.",
        "Original geometry/travel times do not establish load capacity, actuator sizing, road compliance or real bridge safety."
      ]
    },
    "sequenceNumber": 47,
