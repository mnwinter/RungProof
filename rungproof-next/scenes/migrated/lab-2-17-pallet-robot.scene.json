  "training": {
    "hints": [
      "Define the required result before writing logic: Exactly two containers are placed before the pallet conveyor releases.",
      "Treat pallet_ready as simulator-to-PLC inputs. The PLC should command only robot_run, conveyor_run.",
      "Use a step/state approach: approach, grip, lift, carry, lower and release each container before releasing the empty pallet. The offline model uses the imported joints and tool attachment; physical gripping and rated motion remain unverified.",
      "Use placed_count, robot_at_park and cycle_complete feedback to release the empty pallet only after both loads are seated and the robot has completed its park."
    ],
    "solution": {
      "summary": "This is one valid functional reference. The same behavior may be implemented in LAD, FBD, or SCL; the rung layout is not prescribed.",
      "steps": [
        "approach/grip/lift/carry/lower first: robot_run = true, conveyor_run = false.",
        "release first onto rollers, count one, withdraw and park: no PLC command changes.",
        "approach/grip/lift/carry/lower second: no PLC command changes.",
        "release second onto rollers, count two, withdraw and park: no PLC command changes.",
        "release pallet: robot_run = false, conveyor_run = true.",
        "ready: conveyor_run = false."
      ],
      "acceptance": "Exactly two containers are placed before the pallet conveyor releases."
    },
    "machineGuide": {
      "purpose": "A robot transfers two process containers from a staged pallet, then releases the empty pallet to the outbound conveyor.",
      "startConditions": [
        "The common PLC/watchdog foundation is healthy.",
        "All required simulator inputs are at their documented initial state.",
        "The PLC is ready to command robot_run, conveyor_run."
      ],
      "normalSequence": [
        "approach and grip first",
        "lift and carry first around the robot pedestal",
        "lower and release first into its roller bay",
        "withdraw and park after first",
        "approach and grip second",
        "lift and carry second",
        "lower and release second into its roller bay",
        "withdraw and park after second",
        "release pallet",
        "ready"
      ],
      "stopBehavior": [
        "A normal Stop removes commands and freezes the model's joints and held load. It does not establish a physical safe state.",
        "Reset is required before restarting a stopped or completed robot reference.",
        "Reset returns the scene to its documented initial condition."
      ],
      "faultBehavior": [
        "A missing, stale, or incorrectly typed input must not be replaced by simulator logic.",
        "A missing PLC command leaves the affected equipment stopped and the test diagnosable."
      ],
      "expectedObservations": [
        "The timed reference lowers each container into its receiver roller bay before incrementing placed_count and releasing the pallet.",
        "The imported robot joints drive the tool, and the gripped load follows it. The timed reference does not establish physical gripping, manufacturer joint limits or safety."
      ]
    },
