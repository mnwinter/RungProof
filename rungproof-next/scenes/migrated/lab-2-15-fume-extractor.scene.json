  "verification": {
    "cases": [
      {
        "name": "off",
        "expect": {
          "fan_run": false,
          "fan_speed_percent": 0,
          "hood_light_on": false,
          "low_speed": false,
          "medium_speed": false,
          "high_speed": false
        }
      },
      {
        "name": "low-with-light",
        "actions": [
          "toggle-light",
          "next-speed"
        ],
        "expect": {
          "fan_run": true,
          "fan_speed_percent": 35,
          "hood_light_on": true,
          "low_speed": true,
          "medium_speed": false,
          "high_speed": false
        }
      },
      {
        "name": "high",
        "actions": [
          "next-speed",
          "next-speed",
          "next-speed"
        ],
        "expect": {
          "fan_run": true,
          "fan_speed_percent": 100,
          "low_speed": false,
          "medium_speed": false,
          "high_speed": true
        }
      },
      {
        "name": "medium-light-independent",
        "actions": ["toggle-light", "next-speed", "next-speed", "toggle-light"],
        "expect": {
          "fan_run": true,
          "fan_speed_percent": 65,
          "hood_light_on": false,
          "low_speed": false,
          "medium_speed": true,
          "high_speed": false
        }
      },
      {
        "name": "off-after-all-speeds",
        "actions": ["next-speed", "next-speed", "next-speed", "next-speed"],
        "expect": {
          "fan_selector_position": 0,
          "fan_run": false,
          "fan_speed_percent": 0,
          "low_speed": false,
          "medium_speed": false,
          "high_speed": false
        }
      }
    ]
  },
