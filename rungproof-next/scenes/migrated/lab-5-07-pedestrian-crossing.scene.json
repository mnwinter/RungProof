  "training": {
    "hints": [
      "Crossing request is a momentary raw PC input; PATH is manually operated raw feedback, not an automatic pedestrian detector.",
      "PLC logic owns signal colors, sequence state and timers. Green and WALK must never overlap.",
      "Open the reference explicitly or author your own ladder; exercise loading installs no solution."
    ],
    "solution": {
      "summary": "Original offline training reference, with declared timings not supplied by the source lesson.",
      "steps": [
        "Start/restart with red and hand for 3 s; wait for PATH CLEAR before releasing green.",
        "Accept a fresh CROSS edge only while idle and PATH CLEAR. Amber 1 s, all-red 0.5 s, WALK 2 s, steady hand/red clearance 3 s.",
        "Return to green only with PATH CLEAR. Requests during an active sequence or blocked path are discarded."
      ],
      "acceptance": "The reference keeps vehicle red throughout WALK and clearance, then returns to idle only when PATH CLEAR."
    },
    "assetRequirements": [
      "traffic signal head",
      "pedestrian signal head",
      "crosswalk/road module"
    ],
    "machineGuide": {
      "purpose": "A momentary crossing request starts a PLC-owned timed signal sequence over a supported horizontal road and crosswalk.",
      "startConditions": [
        "Built-in offline controller with authored or explicitly opened reference logic.",
        "Initial CROSS released, PATH BLOCK and all commands false. The blank exercise does not start a sequence."
      ],
      "normalSequence": [
        "Open .tools/plant-review-pedestrian-crossing.rpproj.json generated by --audit-pedestrian-crossing.",
        "Run; red/hand startup clearance lasts 3 s. Set PATH CLEAR to release vehicle green.",
        "Press CROSS: amber, all-red, white WALK, then orange hand/red clearance. PATH BLOCK prevents vehicle release."
      ],
      "stopBehavior": [
        "Stop clears symbolic outputs and pending requests; internal phase is retained but Run overrides it with startup clearance before any traffic release.",
        "Reset restores inputs false, phase zero, commands false and stopped scan zero."
      ],
      "expectedObservations": [
        "Two opposing vehicle heads and two far-side pedestrian heads have independent PLC channels.",
        "ROAD and sidewalks physically support the controls; no people or vehicle motion is simulated.",
        "This simplified sequence omits the public-road flashing-hand change interval and is not a road controller or timing design."
      ]
    },
    "sequenceNumber": 46,
