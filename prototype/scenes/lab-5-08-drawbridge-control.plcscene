  "training": {
    "hints": [
      "Translate the lesson into explicit state and permissive logic: Bridge motion and traffic release are mutually interlocked.",
      "Inputs are simulator feedback (traffic_stopped, bridge_request, bridge_home); PLC logic owns bridge_raise, traffic_release.",
      "Test the initial state, the valid condition, and at least one missing permissive."
    ],
    "solution": {
      "summary": "This is an original functional reference for the control concept, not a copy of the photographed solution.",
      "steps": [
        "Require the documented inputs: traffic_stopped, bridge_request, bridge_home.",
        "Command the documented outputs: bridge_raise, traffic_release.",
        "Remove PLC commands when the permissive is lost."
      ],
      "acceptance": "Bridge motion and traffic release are mutually interlocked."
    },
    "assetRequirements": [
      "drawbridge deck",
      "road barrier",
      "bridge limit switches"
    ],
    "machineGuide": {
      "purpose": "A bridge raises only after traffic is stopped and the bridge returns to its home limit before reopening traffic.",
      "startConditions": [
        "The common PLC/watchdog foundation is healthy.",
        "All required simulator inputs are at their documented initial state."
      ],
      "normalSequence": [
        "Apply the requested input condition.",
        "Verify only the documented PLC outputs respond."
      ],
      "stopBehavior": [
        "Removing the permissive removes PLC-owned commands.",
        "Reset returns the module to its initial state."
      ],
      "faultBehavior": [
        "A missing or stale input must fail safe and remain diagnosable."
      ],
      "expectedObservations": [
        "Bridge motion and traffic release are mutually interlocked."
      ]
    },
    "sequenceNumber": 47,
