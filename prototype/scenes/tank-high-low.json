      "Common PLC/watchdog foundation is healthy.",
      "Both pump and drain commands are FALSE; initial level is 50%."
    ],
    "normalSequence": [
      "PLC commands the inlet pump or drain valve.",
      "The liquid surface moves.",
      "The low and high switches change only at their documented elevations."
    ],
    "stopBehavior": [
      "Removing both commands stops level movement."
    ],
    "faultBehavior": [
      "The scene does not create an analog or radar tag.",
      "Missing PLC commands leave the tank process stopped."
    ],
    "expectedObservations": [
      "Only low_level_switch and high_level_switch are external feedback points."
    ]
  },
