        "running": false
      }
    },
    {
      "id": "cnc_infeed_sensor",
      "type": "photoeye",
      "label": "Blank pickup sensor",
      "position": [
        -1.8,
        0,
        0
      ],
      "config": {
        "span": 2.05,
        "height": 0.7,
        "beamCenterHeightM": 1.18,
        "blocked": false
      }
    },
    {
      "id": "cnc_cell_start",
      "type": "switch",
      "label": "Start CNC tending",
      "position": [
        -5.2,
        0,
