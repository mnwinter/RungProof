          },
          "motions": [
            {
              "type": "translate",
              "equipmentId": "finishing_tote",
              "axis": "x",
              "from": 0,
              "to": 2.4
            }
          ]
        },
        {
          "name": "label",
          "durationS": 0.8,
          "set": {
            "conveyor_run": false,
            "labeler_run": true,
            "status_color": "amber"
          }
        },
        {
          "name": "index to inspect",
          "durationS": 1,
          "set": {
            "labeler_run": false,
            "conveyor_run": true,
            "station_number": 4,
            "status_color": "green"
          },
