        "initial": false
      },
      {
        "name": "fill_valve_open",
        "type": "BOOL",
        "owner": "PLC",
        "initial": false
      },
      {
        "name": "capper_run",
        "type": "BOOL",
        "owner": "PLC",
        "initial": false
      },
      {
        "name": "labeler_run",
        "type": "BOOL",
        "owner": "PLC",
        "initial": false
      },
      {
        "name": "inspection_run",
        "type": "BOOL",
        "owner": "PLC",
        "initial": false
      },
      {
        "name": "inspection_ok",
        "type": "BOOL",
        "owner": "PC",
        "initial": false
      },
      {
