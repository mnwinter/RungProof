  "simulation": {
    "type": "sequence",
    "points": [
      {
        "name": "conveyor_run",
        "type": "BOOL",
        "owner": "PLC",
        "initial": false
      },
      {
        "name": "jug_present",
        "type": "BOOL",
        "owner": "PC",
        "initial": false
      },
      {
        "name": "fill_valve_open",
        "type": "BOOL",
        "owner": "PLC",
        "initial": false
      },
      {
        "name": "high_level_probe",
        "type": "BOOL",
        "owner": "PC",
        "initial": false
      },
      {
        "name": "fill_skid_run",
        "type": "BOOL",
        "owner": "PLC",
        "initial": false
      },
      {
        "name": "fill_percent",
        "type": "REAL",
        "owner": "SIM",
        "initial": 0,
        "unit": "%"
      },
      {
        "name": "cell_color",
        "type": "STRING",
        "owner": "SIM",
        "initial": "amber"
      },
      {
        "name": "cycle_complete",
        "type": "BOOL",
        "owner": "SIM",
        "initial": false
      }
    ],
    "actions": [
      {
        "id": "start-fill",
        "label": "Start jug fill",
        "type": "start",
        "sequence": "fill-cycle"
      },
      {
        "id": "stop-fill",
        "label": "Stop fill cell",
        "type": "stop"
      },
      {
        "id": "reset-fill",
        "label": "Reset jug",
        "type": "reset"
      }
    ],
    "pointBindings": [
      {
        "point": "conveyor_run",
        "equipmentId": "fill_conveyor",
        "mode": "running"
      },
      {
        "point": "jug_present",
        "equipmentId": "jug_present_sensor",
