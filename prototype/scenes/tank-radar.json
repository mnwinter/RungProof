{
  "version": 1,
  "machineGuide": {
    "purpose": "A top-mounted radar transmitter reports level, distance, signal, and echo health from one liquid surface.",
    "startConditions": [
      "Common PLC/watchdog foundation is healthy.",
      "Both pump and drain commands are FALSE; initial level is 35%."
    ],
    "normalSequence": [
      "PLC commands the inlet pump or drain valve.",
      "The liquid surface moves.",
      "Radar level rises with the surface, distance falls, and radar_signal follows the idealized range."
    ],
    "stopBehavior": [
      "Removing both commands stops level movement while feedback holds the measured state."
    ],
    "faultBehavior": [
      "A missing or stale radar feedback value is not replaced by the simulator.",
      "The echo state remains the actual configured feedback."
    ],
    "expectedObservations": [
      "The measurement cone terminates at the same liquid surface shown by the tank."
    ]
  },
