  "training": {
    "hints": [
      "Write explicit BOOL commands for each zone; any timed sequence or alarm response must be authored in your ladder, not assumed from the plant.",
      "Inspect actual zone_occupied_0 through zone_occupied_9 feedback. Manual ready/alarm points are not automatic physical interlocks.",
      "Compare intended and wrong valid logic, then confirm invalid current logic cannot execute the previously loaded program."
    ],
    "solution": {
      "summary": "This prose describes the commanded conveyor exercise; it is not an executable grader or a required ladder solution.",
      "steps": [
        "Use declared operator inputs and actual zone occupancy feedback in your own control logic.",
        "Command motor_commands[0..9]; legacy motor_i_run and motor_array_run remain OR-combined alternate commands.",
        "Remove the relevant PLC command in your ladder; a stopped downstream zone blocks material handoff."
      ],
      "acceptance": "Accepted commands drive their corresponding conveyor zones and actual occupancy follows material motion. Valid wrong logic has its actual consequence; invalid current logic cannot execute. No automatic delay, alarm interlock or grader is implied."
    },
    "assetRequirements": [
      "ten commanded conveyor zones with retained motor IDs",
      "group motor status panel",
      "accepted array command display"
    ],
    "machineGuide": {
      "purpose": "Ten conveyor zones retain independent motor IDs and BOOL bindings. Shafts and material follow accepted commands; actual occupancy returns on the next scan. Write your own logic before Run.",
      "startConditions": [
        "The current draft compiles and matches the loaded program in the offline controller.",
        "All required simulator inputs are at their documented initial state."
      ],
      "normalSequence": [
        "Apply the requested input condition.",
        "Verify only the documented PLC outputs respond."
      ],
      "stopBehavior": [
        "Your ladder controls command removal; simulation Stop independently freezes the accepted clock and plant.",
        "Reset returns the module to its initial state."
      ],
      "faultBehavior": [
        "Invalid or mismatched current drafts block execution and remain diagnosable; no automatic physical alarm response is claimed."
      ],
      "expectedObservations": [
        "Accepted commands drive their corresponding conveyor zones and actual occupancy follows material motion. Valid wrong logic has its actual consequence; invalid current logic cannot execute. No automatic delay, alarm interlock or grader is implied."
      ]
    },
