<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>RungProof.Next</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RungProofOfflineDemo)' == 'true'">
    <DefineConstants>$(DefineConstants);RUNGPROOF_OFFLINE_DEMO</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="tools\demo-projects\**\*.cs" />
    <!-- External verification harnesses must never be globbed into the Godot
         assembly, even if a tester accidentally stages one under the root. -->
    <Compile Remove="_agent*\**\*.cs" />
  </ItemGroup>
  <!-- Every Windows development/export compilation binds Test to the complete
       current source closure. A stale manifest must never enable proof awards. -->
  <PropertyGroup><RungProofPowerShell Condition="'$(RungProofPowerShell)' == ''">pwsh.exe</RungProofPowerShell></PropertyGroup>
  <Target Name="GenerateChallengeSemanticManifest" BeforeTargets="CoreCompile" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="&quot;$(RungProofPowerShell)&quot; -NoProfile -File &quot;$(MSBuildProjectDirectory)\tools\verify_godot_source_utf8.ps1&quot; -SourceRoot &quot;$(MSBuildProjectDirectory)&quot;" />
    <Exec Command="&quot;$(RungProofPowerShell)&quot; -NoProfile -File &quot;$(MSBuildProjectDirectory)\tools\build_challenge_semantic_manifest.ps1&quot; -SourceRoot &quot;$(MSBuildProjectDirectory)&quot; -OutputPath &quot;$(MSBuildProjectDirectory)\challenges\semantic-manifest.json&quot;" />
  </Target>
</Project>
